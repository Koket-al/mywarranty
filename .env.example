# ==============================================================================
# EWNET (እውነት) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in local development, or configure these variables
# in your cloud hosting provider (Vercel, Render, Railway, AWS, etc.).

# ------------------------------------------------------------------------------
# 1. API Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
COOKIE_SECRET=change-this-to-a-very-secure-random-32-char-string-in-production

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# For local development with MongoDB installed:
# MONGODB_URI=mongodb://localhost:27017/ewnet
#
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ewnet?retryWrites=true&w=majority
#
# Note: If MONGODB_URI is left blank in local development, Ewnet automatically
# spins up an in-memory MongoDB instance via mongodb-memory-server for zero-friction setup.
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. Cryptographic Asymmetric Signing (RSA-SHA256)
# ------------------------------------------------------------------------------
# Used to sign immutable warranty records and verify cryptographic integrity.
# If left blank in local development, Ewnet automatically generates an ephemeral
# 2048-bit RSA keypair on server boot.
#
# In production, generate keys with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# And provide them as single-line strings with \n or Base64 encoded.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 4. AI Services (Google Gemini)
# ------------------------------------------------------------------------------
# Powers structured customer support investigations, policy drafting suggestions,
# and customer query assistance.
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Email Service (OTP verification, invitations, notifications)
# ------------------------------------------------------------------------------
# Options: "console" (logs OTP to terminal, ideal for dev) or "smtp" (production)
EMAIL_PROVIDER=console
EMAIL_FROM="Ewnet Support <support@ewnet.et>"

# Required if EMAIL_PROVIDER=smtp (e.g., SendGrid, Mailgun, Amazon SES, Brevo):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key

# ------------------------------------------------------------------------------
# 6. File & Media Storage (Receipts, evidence, warranty PDFs)
# ------------------------------------------------------------------------------
# Options: "local" (saves to apps/api/uploads) or "s3" (Cloudflare R2, AWS S3, MinIO)
STORAGE_PROVIDER=local

# Required if STORAGE_PROVIDER=s3:
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ewnet-media
S3_PUBLIC_URL=https://media.ewnet.et

# ------------------------------------------------------------------------------
# 7. Initial Platform Admin Seed Credentials
# ------------------------------------------------------------------------------
# Created automatically when running `npm run seed --workspace=apps/api`
ADMIN_EMAIL=admin@ewnet.et
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# 8. Web Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
# Next.js public API URL. In local dev, Next.js proxies /api to http://localhost:5000.
# In production on Vercel, point this to your deployed Render/Railway API URL:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

